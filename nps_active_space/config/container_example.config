# Container config for the Linux/Wine image (docker/Dockerfile).
# Copy to container.config (or use -e container with this file renamed):
#   cp nps_active_space/config/container_example.config nps_active_space/config/container.config
#
# Use: -e container, with scripts run from /repo (repo root) inside the container.
#
# Mounts (docker/run_activespace.sh; override host paths with env vars):
#   repository checkout     -> /repo        (read-write)
#   NMSIM_RUNTIME           -> /opt/nmsim   (read-only; default vendor/nmsim-runtime/)
#   AAM_RUNTIME + -m aam    -> /opt/aam     (read-only; default vendor/aam-runtime/)
#   DATA_DRIVE              -> /data        (optional read-only host data)
#
# project.nmsim below must be the Wine shim /usr/local/bin/nord2000, not Nord2000batch.exe
# under /opt/nmsim. The shim cd's to /opt/nmsim for RND/; [data] paths stay under /repo/...

[database:overflights]
name =
username =
password =
port =
host =

# Paths MUST be absolute container paths (/repo/...).

[data]
nvspl_archive = /repo/example_data/nvspl_archive
adsb = /repo/example_data/ADS-B/healy_repeater
ais =
dem = /repo/example_data/site_projects/DENATRLA/Input_Data/01_ELEVATION/elevation_m_nad83_utm6.tif
dem_elevation_units = meters
mennitt =

[project]
dir = /repo/example_data/site_projects
nmsim = /usr/local/bin/nord2000
FAA_Releasable_db =
FAA_type_corrections =
