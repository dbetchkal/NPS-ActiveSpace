# Container config for the Linux/Wine image (docker/Dockerfile).
# Copy to container.config (or use -e container with this file renamed):
#   cp nps_active_space/config/container_example.config nps_active_space/config/container.config
#
# Use: -e container, with scripts run from /work (repo root) inside the container.
#
# Mounts (docker/run_activespace.sh):
#   repo          -> /work
#   NMSim runtime -> /opt/nmsim   (populate vendor/nmsim-runtime/ first)
#   data drive    -> /data        (optional; set DATA_DRIVE= when running)

[database:overflights]
name =
username =
password =
port =
host =

# Paths MUST be absolute container paths (/work/...). The wine shim cd's to /opt/nmsim
# for RND/, so relative paths in control files would resolve there and fail.

[data]
site_metadata =
nvspl_archive = /work/example_data/nvspl_archive
adsb = /work/example_data/ADS-B/healy_repeater
ais =
dem = /work/example_data/site_projects/DENATRLA/Input_Data/01_ELEVATION/elevation_m_nad83_utm6.tif
mennitt =

[project]
dir = /work/example_data/site_projects
nmsim = /usr/local/bin/nord2000
FAA_Releasable_db =
FAA_type_corrections =
