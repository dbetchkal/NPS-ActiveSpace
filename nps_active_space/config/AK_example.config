# Example-data parity config — same DENATRLA 2025 slice as DENA_example / container.
# For platform compares (docs/tmp_windows_aam_macparity.bat), copy to AK.config
# and set native [project] nmsim / aam paths. Run scripts from the repo root.
#
# Use: -e AK

[database:overflights]
name =
username =
password =
port =
host =

[data]
nvspl_archive = example_data/nvspl_archive
adsb = example_data/ADS-B/healy_repeater
ais =
dem = example_data/source_dems/DENATRLA_trla_m.tif
dem_elevation_units = meters
mennitt =

[project]
dir = example_data/site_projects
nmsim =
aam =
FAA_Releasable_db = example_data/faa/MASTER_DENATRLA_20250623_sample.txt
FAA_type_corrections = example_data/faa/FAA_AircraftCorrections.json
