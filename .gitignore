# Pycharm
.idea

# venv
.venv*

# python
**/__pycache__
*.pyc

# pyenv
.python-version

# .egg-info
*.egg-info/

# macOS files
.DS_Store

# config files (environment-specific; keep credentials out of repo)
nps_active_space/config/*
!nps_active_space/config/template.config
!nps_active_space/config/*_example.config

# NMSim Windows binaries (not redistributable — see vendor/nmsim-runtime/README.md)
vendor/nmsim-runtime/*
!vendor/nmsim-runtime/README.md
!vendor/nmsim-runtime/.gitkeep

# AAM runtime (not redistributable — see docker/README.md)
vendor/aam-runtime/*
!vendor/aam-runtime/.gitkeep

# Generated Index
example_data/ADS-B/healy_repeater/index.txt
example_data/faa/MASTER_index.json

# Clock drift QC plots (written by run_clock_drift.py)
**/clock_drift_qc/

# ---- Bundled example_data only: pipeline outputs regenerated by local/ container runs ----
example_data/site_projects/*/Output_Data/
example_data/site_projects/fits.csv
example_data/site_projects/*/fits_aam_validate.csv
example_data/site_projects/*/fits_validate.csv

# GDAL / generate-time elevation intermediates (not project_setup artifacts)
example_data/site_projects/*/Input_Data/01_ELEVATION/elevation.tif
example_data/site_projects/*/Input_Data/01_ELEVATION/elevation_mask.*
example_data/site_projects/*/Input_Data/01_ELEVATION/elevation_aam*.tif
example_data/site_projects/*/Input_Data/01_ELEVATION/elevation_*.tif
example_data/site_projects/*/Input_Data/01_ELEVATION/elevation_*_masked.*
example_data/site_projects/*/Input_Data/01_ELEVATION/study_area_*
!example_data/site_projects/*/Input_Data/01_ELEVATION/elevation_m_nad83_utm*.tif
example_data/site_projects/*/Input_Data/AAM/

# Local compare / fit bookkeeping under site directories
example_data/site_projects/*/*_aam_*.csv
example_data/site_projects/*/denatrla_1500m_*.json
denatrla_1500m_*.json

# Batch-run bookkeeping and fit/diagnostic plots under site directories
example_data/site_projects/*/*_commands.txt
example_data/site_projects/*/*_commands_output.csv
example_data/site_projects/*/precision_recall_3d_f1_*.png
example_data/site_projects/*/Altitude_Histogram_*.png

# NMSim control files written at the site root during runs
example_data/site_projects/*/control*
example_data/site_projects/*/batch*

# Docker validation run logs
docker/*.log
